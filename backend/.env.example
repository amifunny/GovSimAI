# Optional. Users typically pass their own OpenAI API key from the browser
# via the `x-openai-api-key` header (BYOK). If both are missing, the API
# returns deterministic demo data so the UI keeps working in dev.
OPENAI_API_KEY=

# Model overrides (optional).
GOVSIM_REASONING_MODEL=gpt-4o-mini
GOVSIM_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant persistent vector DB. Run locally with:
#   docker run -p 6333:6333 -v $(pwd)/qdrant_data:/qdrant/storage qdrant/qdrant
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=govsim_kb

# MCP adapters. Leave URLs blank to use local fallbacks. Configure when you
# have real MCP-compatible HTTP endpoints to call. All adapters POST a JSON
# payload and expect a JSON response.
MCP_AUTH_TOKEN=
MCP_SEARCH_URL=
MCP_PDF_URL=
MCP_STATS_URL=
MCP_GOV_DATA_URL=
MCP_NEWS_URL=
MCP_VIZ_URL=

# Optional News API (used only as a fallback when MCP_NEWS_URL is empty).
NEWS_API_KEY=

# CORS - your Next.js frontend dev + prod URLs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
